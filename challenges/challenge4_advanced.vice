data Player {
    x: int => 100;
    y: int => 100;
    speed: int => 5;
}

data Crystal {
    x: int => 400;
    y: int => 300;
}

data Enemy {
    x: int => 600;
    y: int => 200;
    dx: int => 3;
}

@entry
fn main() {

    let width => 900;
    let height => 700;

    mut score: int => 0;

    mut player => Player();
    mut crystal => Crystal();
    mut enemy => Enemy();

    mut win => ui.create(
        title => "Crystal Collector",
        size => [width, height],
        color => "#111111"
    );

    while (win : is_open) {

        # Player movement
        if (win : key_left) {
            player.x = player.x - player.speed;
        }

        if (win : key_right) {
            player.x = player.x + player.speed;
        }

        if (win : key_up) {
            player.y = player.y - player.speed;
        }

        if (win : key_down) {
            player.y = player.y + player.speed;
        }

        # Enemy movement
        enemy.x = enemy.x + enemy.dx;

        if (enemy.x > width - 60 || enemy.x < 0) {
            enemy.dx = -enemy.dx;
        }

        # Crystal collision
        if (
            player.x < crystal.x + 30 &&
            player.x + 40 > crystal.x &&
            player.y < crystal.y + 30 &&
            player.y + 40 > crystal.y
        ) {

            score = score + 1;

            crystal.x = crystal.x + 70;

            if (crystal.x > width - 40) {
                crystal.x = 50;
            }

            crystal.y = crystal.y + 90;

            if (crystal.y > height - 40) {
                crystal.y = 50;
            }
        }

        # Enemy collision
        if (
            player.x < enemy.x + 60 &&
            player.x + 40 > enemy.x &&
            player.y < enemy.y + 60 &&
            player.y + 40 > enemy.y
        ) {

            output <- "Game Over! Score:", score;

            player.x = 100;
            player.y = 100;

            score = 0;
        }

        # Draw player
        ui.rect(
            pos => [player.x, player.y],
            size => [40, 40],
            color => "#00ff88"
        );

        # Draw crystal
        ui.rect(
            pos => [crystal.x, crystal.y],
            size => [30, 30],
            color => "#00ccff"
        );

        # Draw enemy
        ui.rect(
            pos => [enemy.x, enemy.y],
            size => [60, 60],
            color => "#ff3355"
        );
    }
}