use "std/platformer.vice";

# SKYFORGE CITADEL
# A large Vice 2D platformer/action RPG prototype.
# Run with: vice run examples/skyforge_citadel.vice

enum PlayMode { Title, Playing, Paused, Inventory, Map, Codex, GameOver, Victory }
enum Facing { Left, Right }
enum Biome { Foundry, Garden, Library, Skybridge, Core }

data Hero {
    player: PlatformerPlayer => PlatformerPlayer();
    facing: Facing => Facing.Right;
    hp: int => 100;
    max_hp: int => 100;
    mana: int => 40;
    max_mana: int => 40;
    gems: int => 0;
    keys: int => 0;
    score: int => 0;
    attack_cd: float => 0.0;
    dash_cd: float => 0.0;
    invuln: float => 0.0;
    checkpoint_x: float => 80.0;
    checkpoint_y: float => 420.0;
}

data Enemy {
    id: int => 0;
    name: string => "sentry";
    pos: GameVec2 => GameVec2();
    size: GameVec2 => GameVec2();
    velocity: GameVec2 => GameVec2();
    hp: int => 20;
    max_hp: int => 20;
    damage: int => 10;
    patrol_min: float => 0.0;
    patrol_max: float => 0.0;
    dir: float => 1.0;
    alive: bool => true;
    color: string => "#ff6677";
}

data GemPickup {
    id: int => 0;
    pos: GameVec2 => GameVec2();
    taken: bool => false;
    value: int => 1;
}

data Relic {
    id: int => 0;
    name: string => "Relic";
    pos: GameVec2 => GameVec2();
    taken: bool => false;
    description: string => "";
}

data Projectile {
    pos: GameVec2 => GameVec2();
    velocity: GameVec2 => GameVec2();
    size: GameVec2 => GameVec2();
    damage: int => 12;
    life: float => 0.0;
    from_hero: bool => true;
    active: bool => false;
    color: string => "#88ddff";
}

data Particle {
    pos: GameVec2 => GameVec2();
    velocity: GameVec2 => GameVec2();
    life: float => 0.0;
    color: string => "#ffffff";
    active: bool => false;
}

data Door {
    id: int => 0;
    pos: GameVec2 => GameVec2();
    size: GameVec2 => GameVec2();
    target_room: int => 0;
    target_x: float => 80.0;
    target_y: float => 420.0;
    locked: bool => false;
}

data Room {
    id: int => 0;
    name: string => "Room";
    biome: Biome => Biome.Foundry;
    width: int => 1280;
    height: int => 720;
    floor_y: float => 560.0;
    background: string => "#101820";
    platforms: GameRect[] => [];
    hazards: GameRect[] => [];
    doors: Door[] => [];
    gems: GemPickup[] => [];
    relics: Relic[] => [];
    enemies: Enemy[] => [];
}

data InventoryState {
    sword_level: int => 1;
    armor_level: int => 0;
    boots: bool => false;
    fire_core: bool => false;
    library_key: bool => false;
    relic_names: string[] => [];
}

data QuestState {
    opened_gate: bool => false;
    saved_garden: bool => false;
    awakened_core: bool => false;
    message: string => "Find the three sky relics.";
}

data Game {
    mode: PlayMode => PlayMode.Title;
    timer: GameTime => GameTime();
    camera: GameCamera => GameCamera();
    world: PhysicsWorld => PhysicsWorld();
    hero: Hero => Hero();
    inventory: InventoryState => InventoryState();
    quest: QuestState => QuestState();
    room: Room => Room();
    room_id: int => 0;
    projectiles: Projectile[] => [];
    particles: Particle[] => [];
    play_time: float => 0.0;
    flash: float => 0.0;
}

fn v2(x: float, y: float) -> GameVec2 {
    return game_vec2(x, y);
}

fn rect(x: float, y: float, w: float, h: float) -> GameRect {
    return game_rect(x, y, w, h);
}

fn body_at(x: float, y: float, w: float, h: float) -> PhysicsBody {
    return physics_body(v2(x, y), v2(w, h));
}

fn hero_rect(hero: Hero) -> GameRect {
    return physics_body_rect(hero.player.body);
}

fn enemy_rect(enemy: Enemy) -> GameRect {
    return rect(enemy.pos.x, enemy.pos.y, enemy.size.x, enemy.size.y);
}

fn projectile_rect(projectile: Projectile) -> GameRect {
    return rect(projectile.pos.x, projectile.pos.y, projectile.size.x, projectile.size.y);
}

fn gem_rect(gem: GemPickup) -> GameRect {
    return rect(gem.pos.x, gem.pos.y, 20.0, 20.0);
}

fn relic_rect(relic: Relic) -> GameRect {
    return rect(relic.pos.x, relic.pos.y, 28.0, 28.0);
}

fn door_rect(door: Door) -> GameRect {
    return rect(door.pos.x, door.pos.y, door.size.x, door.size.y);
}

fn make_hero() -> Hero {
    mut hero => Hero();
    hero.player = platformer_default_player();
    hero.player.body = body_at(80.0, 420.0, 30.0, 44.0);
    hero.player.speed = 280.0;
    hero.player.jump_speed = 620.0;
    hero.player.color = "#55ffff";
    hero.facing = Facing.Right;
    hero.hp = 100;
    hero.max_hp = 100;
    hero.mana = 40;
    hero.max_mana = 40;
    hero.gems = 0;
    hero.keys = 0;
    hero.score = 0;
    hero.attack_cd = 0.0;
    hero.dash_cd = 0.0;
    hero.invuln = 0.0;
    hero.checkpoint_x = 80.0;
    hero.checkpoint_y = 420.0;
    return hero;
}

fn make_enemy(id: int, name: string, x: float, y: float, w: float, h: float, hp: int, dmg: int, left: float, right: float, color: string) -> Enemy {
    mut enemy => Enemy();
    enemy.id = id;
    enemy.name = name;
    enemy.pos = v2(x, y);
    enemy.size = v2(w, h);
    enemy.velocity = v2(70.0, 0.0);
    enemy.hp = hp;
    enemy.max_hp = hp;
    enemy.damage = dmg;
    enemy.patrol_min = left;
    enemy.patrol_max = right;
    enemy.dir = 1.0;
    enemy.alive = true;
    enemy.color = color;
    return enemy;
}

fn make_gem(id: int, x: float, y: float, value: int) -> GemPickup {
    mut gem => GemPickup();
    gem.id = id;
    gem.pos = v2(x, y);
    gem.taken = false;
    gem.value = value;
    return gem;
}

fn make_relic(id: int, name: string, x: float, y: float, description: string) -> Relic {
    mut relic => Relic();
    relic.id = id;
    relic.name = name;
    relic.pos = v2(x, y);
    relic.taken = false;
    relic.description = description;
    return relic;
}

fn make_door(id: int, x: float, y: float, target_room: int, target_x: float, target_y: float, locked: bool) -> Door {
    mut door => Door();
    door.id = id;
    door.pos = v2(x, y);
    door.size = v2(36.0, 72.0);
    door.target_room = target_room;
    door.target_x = target_x;
    door.target_y = target_y;
    door.locked = locked;
    return door;
}

fn make_projectile(pos: GameVec2, facing: Facing, damage: int) -> Projectile {
    mut projectile => Projectile();
    projectile.pos = v2(pos.x, pos.y + 18.0);
    projectile.size = v2(18.0, 8.0);
    projectile.velocity = v2(520.0, 0.0);
    if (facing == Facing.Left) {
        projectile.velocity.x = 0.0 - 520.0;
    }
    projectile.damage = damage;
    projectile.life = 0.8;
    projectile.from_hero = true;
    projectile.active = true;
    projectile.color = "#88ddff";
    return projectile;
}

fn make_particle(x: float, y: float, vx: float, vy: float, color: string) -> Particle {
    mut particle => Particle();
    particle.pos = v2(x, y);
    particle.velocity = v2(vx, vy);
    particle.life = 0.45;
    particle.color = color;
    particle.active = true;
    return particle;
}

fn make_room(id: int, name: string, biome: Biome, bg: string, floor_y: float) -> Room {
    mut room => Room();
    room.id = id;
    room.name = name;
    room.biome = biome;
    room.width = 1280;
    room.height = 720;
    room.floor_y = floor_y;
    room.background = bg;
    room.platforms = [];
    room.hazards = [];
    room.doors = [];
    room.gems = [];
    room.relics = [];
    room.enemies = [];
    return room;
}

fn add_platform(mut room: Room, x: float, y: float, w: float, h: float) -> Room {
    room.platforms.push(rect(x, y, w, h));
    return room;
}

fn add_hazard(mut room: Room, x: float, y: float, w: float, h: float) -> Room {
    room.hazards.push(rect(x, y, w, h));
    return room;
}

fn add_enemy(mut room: Room, enemy: Enemy) -> Room {
    room.enemies.push(enemy);
    return room;
}

fn add_gem(mut room: Room, gem: GemPickup) -> Room {
    room.gems.push(gem);
    return room;
}

fn add_relic(mut room: Room, relic: Relic) -> Room {
    room.relics.push(relic);
    return room;
}

fn add_door(mut room: Room, door: Door) -> Room {
    room.doors.push(door);
    return room;
}

fn build_foundry_gate() -> Room {
    mut room => make_room(0, "Foundry Gate", Biome.Foundry, "#181018", 560.0);
    room = add_platform(room, 160.0, 480.0, 160.0, 24.0);
    room = add_platform(room, 380.0, 420.0, 180.0, 24.0);
    room = add_platform(room, 660.0, 370.0, 160.0, 24.0);
    room = add_platform(room, 920.0, 450.0, 180.0, 24.0);
    room = add_hazard(room, 560.0, 552.0, 160.0, 12.0);
    room = add_gem(room, make_gem(1, 210.0, 440.0, 2));
    room = add_gem(room, make_gem(2, 440.0, 380.0, 2));
    room = add_gem(room, make_gem(3, 710.0, 330.0, 3));
    room = add_enemy(room, make_enemy(1, "ash crawler", 520.0, 516.0, 32.0, 32.0, 22, 8, 420.0, 620.0, "#ff7755"));
    room = add_enemy(room, make_enemy(2, "forge bat", 850.0, 415.0, 28.0, 28.0, 16, 7, 780.0, 1040.0, "#dd55ff"));
    room = add_door(room, make_door(1, 1210.0, 488.0, 1, 70.0, 420.0, false));
    return room;
}

fn build_ember_lift() -> Room {
    mut room => make_room(1, "Ember Lift", Biome.Foundry, "#201010", 580.0);
    room = add_platform(room, 120.0, 500.0, 140.0, 24.0);
    room = add_platform(room, 310.0, 440.0, 120.0, 24.0);
    room = add_platform(room, 500.0, 380.0, 120.0, 24.0);
    room = add_platform(room, 700.0, 320.0, 120.0, 24.0);
    room = add_platform(room, 890.0, 410.0, 260.0, 24.0);
    room = add_hazard(room, 300.0, 572.0, 520.0, 12.0);
    room = add_gem(room, make_gem(10, 340.0, 400.0, 3));
    room = add_gem(room, make_gem(11, 540.0, 340.0, 3));
    room = add_gem(room, make_gem(12, 745.0, 280.0, 4));
    room = add_enemy(room, make_enemy(10, "coal knight", 930.0, 370.0, 36.0, 44.0, 35, 12, 880.0, 1110.0, "#cc4433"));
    room = add_door(room, make_door(10, 20.0, 508.0, 0, 1140.0, 420.0, false));
    room = add_door(room, make_door(11, 1210.0, 508.0, 2, 70.0, 420.0, false));
    return room;
}

