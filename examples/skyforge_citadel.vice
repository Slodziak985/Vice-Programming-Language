    return room;
}

fn build_all_rooms() -> Room[] {
    mut rooms: Room[] => [];
    rooms.push(build_foundry_gate());
    rooms.push(build_ember_lift());
    rooms.push(build_glass_garden());
    rooms.push(build_archive_steps());
    rooms.push(build_skybridge());
    rooms.push(build_star_core());
    rooms.push(build_room_06());
    rooms.push(build_room_07());
    rooms.push(build_room_08());
    rooms.push(build_room_09());
    rooms.push(build_room_10());
    return rooms;
}

fn build_room_by_id(room_id: int) -> Room {
    match room_id {
        0 => { return build_foundry_gate(); }
        1 => { return build_ember_lift(); }
        2 => { return build_glass_garden(); }
        3 => { return build_archive_steps(); }
        4 => { return build_skybridge(); }
        5 => { return build_star_core(); }
        6 => { return build_room_06(); }
        7 => { return build_room_07(); }
        8 => { return build_room_08(); }
        9 => { return build_room_09(); }
        10 => { return build_room_10(); }
        _ => { return build_foundry_gate(); }
    }
}

fn current_room(game: Game) -> Room {
    return game.room;
}

fn replace_current_room(mut game: Game, room: Room) -> Game {
    game.room = room;
    return game;
}

fn init_game() -> Game {
    mut game => Game();
    game.mode = PlayMode.Title;
    game.timer = game_time_start();
    game.camera = game_camera(960, 540);
    game.world = PhysicsWorld();
    game.hero = make_hero();
    game.inventory = InventoryState();
    game.quest = QuestState();
    game.room_id = 0;
    game.room = build_room_by_id(0);
    game.projectiles = [];
    game.particles = [];
    game.play_time = 0.0;
    game.flash = 0.0;
    return game;
}

fn apply_room_unlocks(mut game: Game) -> Game {
    if (game.hero.gems >= 10) {
        game.inventory.library_key = true;
    }
    if (len(game.inventory.relic_names) >= 1) {
        game.quest.saved_garden = true;
    }
    if (len(game.inventory.relic_names) >= 2) {
        game.quest.opened_gate = true;
    }
    if (len(game.inventory.relic_names) >= 3) {
        game.quest.awakened_core = true;
        game.mode = PlayMode.Victory;
    }
    return game;
}

fn handle_title(mut game: Game) -> Game {
    ui.draw_rect(pos => [0, 0], size => [960, 540], color => "#090b12");
    ui.text(text => "SKYFORGE CITADEL", pos => [300, 140], color => "#88ddff");
    ui.text(text => "A huge Vice platformer prototype", pos => [300, 180], color => "#ffffff");
    ui.text(text => "Arrows/WASD move | Space jumps | F shoots | I inventory | M map", pos => [180, 230], color => "#cccccc");
    let start => ui.button(id => "title.start", text => "Begin Expedition", pos => [360, 310], size => [240, 46], color => "#b7f34a");
    if (start.clicked || ui.is_key_pressed("Enter")) {
        game.mode = PlayMode.Playing;
        game.timer = game_time_start();
    }
    return game;
}

fn handle_pause(mut game: Game) -> Game {
    ui.draw_rect(pos => [0, 0], size => [960, 540], color => "#000000aa");
    ui.text(text => "PAUSED", pos => [420, 210], color => "#ffffff");
    ui.text(text => "Press Escape to resume", pos => [360, 250], color => "#cccccc");
    if (ui.is_key_pressed("Escape")) {
        game.mode = PlayMode.Playing;
    }
    return game;
}

fn update_controls(mut game: Game) -> Game {
    if (ui.is_key_pressed("Escape")) {
        game.mode = PlayMode.Paused;
    }
    if (ui.is_key_pressed("KeyI")) {
        game.mode = PlayMode.Inventory;
    }
    if (ui.is_key_pressed("KeyM")) {
        game.mode = PlayMode.Map;
    }
    if (ui.is_key_pressed("KeyC")) {
        game.mode = PlayMode.Codex;
    }
    return game;
}

fn update_hero_movement(mut game: Game, room: Room, dt: float) -> Game {
    let controls => platformer_input();
    if (controls.left) {
        game.hero.facing = Facing.Left;
    }
    if (controls.right) {
        game.hero.facing = Facing.Right;
    }
    game.hero.player = platformer_update_player(game.hero.player, controls, room_to_platformer(room), game.world, dt);
    game.camera = game_camera_follow(game.camera, game.hero.player.body.pos);
    return game;
}

fn room_to_platformer(room: Room) -> PlatformerLevel {
    mut level => PlatformerLevel();
    level.width = room.width;
    level.height = room.height;
    level.floor_y = room.floor_y;
    level.platforms = room.platforms;
    return level;
}

fn update_cooldowns(mut game: Game, dt: float) -> Game {
    if (game.hero.attack_cd > 0.0) {
        game.hero.attack_cd -= dt;
    }
    if (game.hero.dash_cd > 0.0) {
        game.hero.dash_cd -= dt;
    }
    if (game.hero.invuln > 0.0) {
        game.hero.invuln -= dt;
    }
    if (game.flash > 0.0) {
        game.flash -= dt;
    }
    if (game.hero.mana < game.hero.max_mana) {
        game.hero.mana += 1;
    }
    return game;
}

fn update_attacks(mut game: Game) -> Game {
    if (ui.is_key_pressed("KeyF") && game.hero.attack_cd <= 0.0 && game.hero.mana >= 4) {
        game.hero.attack_cd = 0.25;
        game.hero.mana -= 4;
        game.projectiles.push(make_projectile(game.hero.player.body.pos, game.hero.facing, 12 + game.inventory.sword_level * 4));
    }
    return game;
}

fn update_projectiles(mut game: Game, dt: float) -> Game {
    if (len(game.projectiles) == 0) {
        return game;
    }
    mut kept: Projectile[] => [];
    let mut room => current_room(game);
    for i in 0..(len(game.projectiles) - 1) {
        let mut projectile => game.projectiles[i];
        projectile.pos.x += projectile.velocity.x * dt;
        projectile.pos.y += projectile.velocity.y * dt;
        projectile.life -= dt;
        let mut hit => false;
        if (len(room.enemies) > 0) {
            for e in 0..(len(room.enemies) - 1) {
                let mut enemy => room.enemies[e];
                if (enemy.alive && game_rects_overlap(projectile_rect(projectile), enemy_rect(enemy))) {
                    enemy.hp -= projectile.damage;
                    hit = true;
                    game.hero.score += 1;
                    game.particles.push(make_particle(enemy.pos.x, enemy.pos.y, 40.0, 0.0 - 120.0, "#88ddff"));
                    if (enemy.hp <= 0) {
                        enemy.alive = false;
                        game.hero.score += enemy.max_hp;
                        game.particles.push(make_particle(enemy.pos.x, enemy.pos.y, 0.0, 0.0 - 180.0, "#ffaa33"));
                    }
                }
                room.enemies[e] = enemy;
            }
        }
        if (projectile.life > 0.0 && !hit) {
            kept.push(projectile);
        }
    }
    game.projectiles = kept;
    game = replace_current_room(game, room);
    return game;
}

fn update_enemies(mut game: Game, dt: float) -> Game {
    let mut room => current_room(game);
    if (len(room.enemies) == 0) {
        return game;
    }
    for i in 0..(len(room.enemies) - 1) {
        let mut enemy => room.enemies[i];
        if (enemy.alive) {
            enemy.pos.x += enemy.velocity.x * enemy.dir * dt;
            if (enemy.pos.x < enemy.patrol_min) {
                enemy.pos.x = enemy.patrol_min;
                enemy.dir = 1.0;
            }
            if (enemy.pos.x > enemy.patrol_max) {
                enemy.pos.x = enemy.patrol_max;
                enemy.dir = 0.0 - 1.0;
            }
            if (game_rects_overlap(hero_rect(game.hero), enemy_rect(enemy)) && game.hero.invuln <= 0.0) {
                game.hero.hp -= enemy.damage;
                game.hero.invuln = 1.0;
                game.flash = 0.3;
                if (game.hero.facing == Facing.Right) {
                    game.hero.player.body.pos.x -= 28.0;
                } else {
                    game.hero.player.body.pos.x += 28.0;
                }
            }
        }
        room.enemies[i] = enemy;
    }
    game = replace_current_room(game, room);
    return game;
}

fn update_pickups(mut game: Game) -> Game {
    let mut room => current_room(game);
    if (len(room.gems) > 0) {
        for i in 0..(len(room.gems) - 1) {
            let mut gem => room.gems[i];
            if (!gem.taken && game_rects_overlap(hero_rect(game.hero), gem_rect(gem))) {
                gem.taken = true;
                game.hero.gems += gem.value;
                game.hero.score += gem.value * 10;
                game.particles.push(make_particle(gem.pos.x, gem.pos.y, 0.0, 0.0 - 120.0, "#ffff66"));
            }
            room.gems[i] = gem;
        }
    }
    if (len(room.relics) > 0) {
        for r in 0..(len(room.relics) - 1) {
            let mut relic => room.relics[r];
            if (!relic.taken && game_rects_overlap(hero_rect(game.hero), relic_rect(relic))) {
                relic.taken = true;
                game.inventory.relic_names.push(relic.name);
                game.quest.message = relic.description;
                game.hero.score += 250;
                game.flash = 0.6;
            }
            room.relics[r] = relic;
        }
    }
    game = replace_current_room(game, room);
    return game;
}

fn update_hazards(mut game: Game) -> Game {
    let room => current_room(game);
    if (len(room.hazards) == 0) {
        return game;
    }
    for i in 0..(len(room.hazards) - 1) {
        if (game_rects_overlap(hero_rect(game.hero), room.hazards[i]) && game.hero.invuln <= 0.0) {
            game.hero.hp -= 15;
            game.hero.invuln = 1.2;
            game.hero.player.body.pos.x = game.hero.checkpoint_x;
            game.hero.player.body.pos.y = game.hero.checkpoint_y;
        }
    }
    return game;
}

fn update_doors(mut game: Game) -> Game {
    let room => current_room(game);
    if (len(room.doors) == 0) {
        return game;
    }
    for i in 0..(len(room.doors) - 1) {
        let door => room.doors[i];
        if (game_rects_overlap(hero_rect(game.hero), door_rect(door)) && ui.is_key_pressed("KeyE")) {
            if (door.locked && game.hero.gems < 10 && !game.inventory.library_key) {
                game.quest.message = "The gate needs ten gems or a library key.";
            } else {
                game.room_id = door.target_room;
                game.room = build_room_by_id(door.target_room);
                game.hero.player.body.pos.x = door.target_x;
                game.hero.player.body.pos.y = door.target_y;
                game.hero.checkpoint_x = door.target_x;
                game.hero.checkpoint_y = door.target_y;
                game.camera = game_camera_follow(game.camera, game.hero.player.body.pos);
            }
        }
    }
    return game;
}

fn update_particles(mut game: Game, dt: float) -> Game {
    mut kept: Particle[] => [];
    if (len(game.particles) == 0) {
        return game;
    }
    for i in 0..(len(game.particles) - 1) {
        let mut p => game.particles[i];
        p.pos.x += p.velocity.x * dt;
        p.pos.y += p.velocity.y * dt;
        p.life -= dt;
        if (p.life > 0.0) {
            kept.push(p);
        }
    }
    game.particles = kept;
    return game;
}

fn update_death(mut game: Game) -> Game {
    if (game.hero.hp <= 0) {
        game.mode = PlayMode.GameOver;
    }
    return game;
}

fn update_playing(mut game: Game) -> Game {
    game.timer = game_time_tick(game.timer);
    let dt => game.timer.delta;
    game.play_time += dt;
    let room => current_room(game);
    game = update_controls(game);
    if (game.mode != PlayMode.Playing) {
        return game;
    }
    game = update_cooldowns(game, dt);
    game = update_hero_movement(game, room, dt);
    game = update_attacks(game);
    game = update_projectiles(game, dt);
    game = update_enemies(game, dt);
    game = update_pickups(game);
    game = update_hazards(game);
    game = update_doors(game);
    game = update_particles(game, dt);
    game = apply_room_unlocks(game);
    game = update_death(game);
    return game;
}

fn draw_background(room: Room) {
    ui.draw_rect(pos => [0, 0], size => [960, 540], color => room.background);
    ui.draw_rect(pos => [0, 0], size => [960, 80], color => "#00000055");
}

fn draw_room(room: Room, camera: GameCamera) {
    draw_background(room);
    game_draw_rect_world(rect(0.0, room.floor_y, to_float(room.width), 80.0), camera, "#27343a");
    if (len(room.platforms) > 0) {
        for i in 0..(len(room.platforms) - 1) {
            game_draw_rect_world(room.platforms[i], camera, "#6f8190");
        }
    }
    if (len(room.hazards) > 0) {
        for h in 0..(len(room.hazards) - 1) {
            game_draw_rect_world(room.hazards[h], camera, "#ff3355");
        }
    }
    if (len(room.doors) > 0) {
        for d in 0..(len(room.doors) - 1) {
            let door => room.doors[d];
            let color => "#88ddff";
            game_draw_rect_world(door_rect(door), camera, color);
        }
    }
}

fn draw_pickups(room: Room, camera: GameCamera) {
    if (len(room.gems) > 0) {
        for i in 0..(len(room.gems) - 1) {
            let gem => room.gems[i];
            if (!gem.taken) {
                game_draw_rect_world(gem_rect(gem), camera, "#ffff66");
            }
        }
    }
    if (len(room.relics) > 0) {
        for r in 0..(len(room.relics) - 1) {
            let relic => room.relics[r];
            if (!relic.taken) {
                game_draw_rect_world(relic_rect(relic), camera, "#ffccff");
            }
        }
    }
}

fn draw_enemies(room: Room, camera: GameCamera) {
    if (len(room.enemies) == 0) {
        return;
    }
    for i in 0..(len(room.enemies) - 1) {
        let enemy => room.enemies[i];
        if (enemy.alive) {
            game_draw_rect_world(enemy_rect(enemy), camera, enemy.color);
            let bar_w => enemy.size.x * (to_float(enemy.hp) / to_float(enemy.max_hp));
            game_draw_rect_world(rect(enemy.pos.x, enemy.pos.y - 8.0, bar_w, 4.0), camera, "#66ff66");
        }
    }
}

fn draw_projectiles(projectiles: Projectile[], camera: GameCamera) {
    if (len(projectiles) == 0) {
        return;
    }
    for i in 0..(len(projectiles) - 1) {
        game_draw_rect_world(projectile_rect(projectiles[i]), camera, projectiles[i].color);
    }
}

fn draw_particles(particles: Particle[], camera: GameCamera) {
    if (len(particles) == 0) {
        return;
    }
    for i in 0..(len(particles) - 1) {
        let p => particles[i];
        game_draw_rect_world(rect(p.pos.x, p.pos.y, 6.0, 6.0), camera, p.color);
    }
}

fn draw_hero(hero: Hero, camera: GameCamera) {
    let mut color => hero.player.color;
    if (hero.invuln > 0.0) {
        color = "#ffffff";
    }
    game_draw_rect_world(hero_rect(hero), camera, color);
}

fn draw_hud(game: Game) {
    ui.draw_rect(pos => [0, 0], size => [960, 58], color => "#000000aa");
    ui.text(text => "HP ${game.hero.hp}/${game.hero.max_hp}", pos => [20, 18], color => "#ff7777");
    ui.text(text => "Mana ${game.hero.mana}/${game.hero.max_mana}", pos => [150, 18], color => "#88ddff");
    ui.text(text => "Gems ${game.hero.gems}", pos => [320, 18], color => "#ffff66");
    ui.text(text => "Score ${game.hero.score}", pos => [430, 18], color => "#ffffff");
    ui.text(text => current_room(game).name, pos => [650, 18], color => "#b7f34a");
    ui.text(text => "E door | F shoot | I inv | M map | C codex", pos => [20, 500], color => "#cccccc");
    if (game.quest.message != "") {
        ui.text(text => game.quest.message, pos => [20, 470], color => "#d8c7ff");
    }
}

fn draw_playing(game: Game) {
    let room => current_room(game);
    draw_room(room, game.camera);
    draw_pickups(room, game.camera);
    draw_enemies(room, game.camera);
    draw_projectiles(game.projectiles, game.camera);
    draw_particles(game.particles, game.camera);
    draw_hero(game.hero, game.camera);
    draw_hud(game);
    if (game.flash > 0.0) {
        ui.draw_rect(pos => [0, 0], size => [960, 540], color => "#ffffff33");
    }
}

fn draw_inventory(mut game: Game) -> Game {
    ui.draw_rect(pos => [0, 0], size => [960, 540], color => "#080a10");
    ui.text(text => "INVENTORY", pos => [40, 40], color => "#b7f34a");
    ui.text(text => "Sword Level: ${game.inventory.sword_level}", pos => [60, 100], color => "#ffffff");
    ui.text(text => "Armor Level: ${game.inventory.armor_level}", pos => [60, 130], color => "#ffffff");
    ui.text(text => "Boots: ${game.inventory.boots}", pos => [60, 160], color => "#ffffff");
    ui.text(text => "Fire Core: ${game.inventory.fire_core}", pos => [60, 190], color => "#ffffff");
    ui.text(text => "Relics: ${len(game.inventory.relic_names)}/3", pos => [60, 220], color => "#ffccff");
    if (len(game.inventory.relic_names) > 0) {
        for i in 0..(len(game.inventory.relic_names) - 1) {
            ui.text(text => "- ${game.inventory.relic_names[i]}", pos => [80, 260 + i * 26], color => "#ffccff");
        }
    }
    ui.text(text => "Press Enter or Escape to return", pos => [60, 470], color => "#cccccc");
    if (ui.is_key_pressed("Enter") || ui.is_key_pressed("Escape")) {
        game.mode = PlayMode.Playing;
    }
    return game;
}

fn draw_map(mut game: Game) -> Game {
    ui.draw_rect(pos => [0, 0], size => [960, 540], color => "#071018");
    ui.text(text => "CITADEL MAP", pos => [40, 40], color => "#88ddff");
    for i in 0..10 {
        let x => 80 + (i * 76);
        let y => 180 + ((i / 6) * 90);
        let mut color => "#334455";
        if (i == game.room_id) {
            color = "#b7f34a";
        }
        ui.draw_rect(pos => [x, y], size => [62, 40], color => color);
        ui.text(text => "${i}", pos => [x + 20, y + 12], color => "#ffffff");
    }
    ui.text(text => "Current room: ${current_room(game).name}", pos => [40, 420], color => "#ffffff");
    ui.text(text => "Press Enter or Escape to return", pos => [40, 470], color => "#cccccc");
    if (ui.is_key_pressed("Enter") || ui.is_key_pressed("Escape")) {
        game.mode = PlayMode.Playing;
    }
    return game;
}

fn draw_codex(mut game: Game) -> Game {
    ui.draw_rect(pos => [0, 0], size => [960, 540], color => "#0b0814");
    ui.text(text => "CODEX", pos => [40, 40], color => "#d8c7ff");
    ui.text(text => "The Skyforge was built to hold a sleeping star.", pos => [60, 110], color => "#ffffff");
    ui.text(text => "Foundry: old machines and molten traps.", pos => [60, 145], color => "#ffaa88");
    ui.text(text => "Garden: living glass and thorn guardians.", pos => [60, 180], color => "#99ff99");
    ui.text(text => "Library: ink spirits and locked knowledge.", pos => [60, 215], color => "#aaaaff");
    ui.text(text => "Skybridge: storms below, stars above.", pos => [60, 250], color => "#88ddff");
    ui.text(text => "Core: collect three relics to awaken it.", pos => [60, 285], color => "#ff99dd");
    ui.text(text => "Press Enter or Escape to return", pos => [60, 470], color => "#cccccc");
    if (ui.is_key_pressed("Enter") || ui.is_key_pressed("Escape")) {
        game.mode = PlayMode.Playing;
    }
    return game;
}

fn draw_game_over(mut game: Game) -> Game {
    ui.draw_rect(pos => [0, 0], size => [960, 540], color => "#180000");
    ui.text(text => "GAME OVER", pos => [390, 190], color => "#ff5555");
    ui.text(text => "Score: ${game.hero.score}", pos => [400, 235], color => "#ffffff");
    let retry => ui.button(id => "game.retry", text => "Retry", pos => [380, 300], size => [200, 44], color => "#b7f34a");
    if (retry.clicked || ui.is_key_pressed("Enter")) {
        game = init_game();
        game.mode = PlayMode.Playing;
    }
    return game;
}

fn draw_victory(mut game: Game) -> Game {
    ui.draw_rect(pos => [0, 0], size => [960, 540], color => "#101020");
    ui.text(text => "THE STAR AWAKENS", pos => [330, 150], color => "#ffff99");
    ui.text(text => "You restored the Skyforge Citadel.", pos => [330, 200], color => "#ffffff");
    ui.text(text => "Final score: ${game.hero.score}", pos => [330, 240], color => "#b7f34a");
    let again => ui.button(id => "victory.again", text => "Play Again", pos => [380, 320], size => [200, 44], color => "#88ddff");
    if (again.clicked || ui.is_key_pressed("Enter")) {
        game = init_game();
        game.mode = PlayMode.Playing;
    }
    return game;
}

fn debug_spawn_particles(mut game: Game) -> Game {
    if (ui.is_key_pressed("KeyP")) {
        game.particles.push(make_particle(game.hero.player.body.pos.x, game.hero.player.body.pos.y, 80.0, 0.0 - 120.0, "#ffffff"));
        game.particles.push(make_particle(game.hero.player.body.pos.x, game.hero.player.body.pos.y, 0.0 - 80.0, 0.0 - 120.0, "#ffff66"));
    }
    return game;
}

fn upgrade_shop(mut game: Game) -> Game {
    if (game.hero.gems >= 12 && game.inventory.sword_level < 3) {
        game.inventory.sword_level += 1;
        game.hero.gems -= 12;
        game.quest.message = "Sword upgraded by citadel memory.";
    }
    return game;
}

fn room_biome_name(room: Room) -> string {
    match room.biome {
        Biome.Foundry => { return "Foundry"; }
        Biome.Garden => { return "Garden"; }
        Biome.Library => { return "Library"; }
        Biome.Skybridge => { return "Skybridge"; }
        Biome.Core => { return "Core"; }
    }
}

fn draw_room_banner(game: Game) {
    let room => current_room(game);
    ui.text(text => "${room.name} / ${room_biome_name(room)}", pos => [650, 45], color => "#cccccc");
}

fn draw_extended_hud(game: Game) {
    draw_room_banner(game);
    ui.text(text => "Relics ${len(game.inventory.relic_names)}/3", pos => [780, 45], color => "#ffccff");
}

fn simulate_weather(mut game: Game) -> Game {
    let room => current_room(game);
    if (room.biome == Biome.Skybridge && game.timer.elapsed_ms - ((game.timer.elapsed_ms / 700) * 700) < 20) {
        game.particles.push(make_particle(game.hero.player.body.pos.x + 120.0, game.hero.player.body.pos.y - 160.0, 0.0 - 80.0, 160.0, "#88ddff"));
    }
    return game;
}

fn simulate_core_heat(mut game: Game) -> Game {
    let room => current_room(game);
    if (room.biome == Biome.Core && game.timer.elapsed_ms - ((game.timer.elapsed_ms / 500) * 500) < 20) {
        game.particles.push(make_particle(game.hero.player.body.pos.x - 80.0, game.hero.player.body.pos.y + 40.0, 40.0, 0.0 - 160.0, "#ff66cc"));
    }
    return game;
}

fn late_update(mut game: Game) -> Game {
    game = debug_spawn_particles(game);
    game = simulate_weather(game);
    game = simulate_core_heat(game);
    if (ui.is_key_pressed("KeyU")) {
        game = upgrade_shop(game);
    }
    return game;
}

fn render_mode(mut game: Game) -> Game {
    match game.mode {
        PlayMode.Title => {
            game = handle_title(game);
        }
        PlayMode.Playing => {
            draw_playing(game);
            draw_extended_hud(game);
        }
        PlayMode.Paused => {
            draw_playing(game);
            game = handle_pause(game);
        }
        PlayMode.Inventory => {
            game = draw_inventory(game);
        }
        PlayMode.Map => {
            game = draw_map(game);
        }
        PlayMode.Codex => {
            game = draw_codex(game);
        }
        PlayMode.GameOver => {
            game = draw_game_over(game);
        }
        PlayMode.Victory => {
            game = draw_victory(game);
        }
    }
    return game;
}

fn scripted_room_note(room_id: int) -> string {
    match room_id {
        0 => { return "The gate hums with heat."; }
        1 => { return "Chains move somewhere above."; }
        2 => { return "The glass leaves sing quietly."; }
        3 => { return "Books watch from every shelf."; }
        4 => { return "Clouds churn below the bridge."; }
        5 => { return "The star is almost awake."; }
        6 => { return "Annex six calibrates movement."; }
        7 => { return "Annex seven tests patience."; }
        8 => { return "Annex eight stores spare ink."; }
        9 => { return "Annex nine is mostly wind."; }
        10 => { return "Annex ten glows with old power."; }
        _ => { return "The citadel shifts."; }
    }
}

fn update_room_message(mut game: Game) -> Game {
    if (game.timer.elapsed_ms < 1000) {
        game.quest.message = scripted_room_note(game.room_id);
    }
    return game;
}

fn run_frame(mut game: Game) -> Game {
    if (game.mode == PlayMode.Playing) {
        game = update_playing(game);
        game = late_update(game);
        game = update_room_message(game);
    }
    game = render_mode(game);
    return game;
}

@entry
fn main() {
    mut window => ui.window(
        title => "Skyforge Citadel",
        size => [960, 540],
        color => "#080c0e"
    );

    mut game => init_game();

    while (ui.frame(window)) {
        game = run_frame(game);
    }
}
