    mut room => make_room(2, "Glass Garden", Biome.Garden, "#102018", 560.0);
    room = add_platform(room, 170.0, 460.0, 180.0, 22.0);
    room = add_platform(room, 430.0, 385.0, 160.0, 22.0);
    room = add_platform(room, 650.0, 470.0, 200.0, 22.0);
    room = add_platform(room, 940.0, 350.0, 160.0, 22.0);
    room = add_hazard(room, 780.0, 552.0, 120.0, 12.0);
    room = add_gem(room, make_gem(20, 220.0, 420.0, 4));
    room = add_gem(room, make_gem(21, 490.0, 345.0, 4));
    room = add_gem(room, make_gem(22, 1000.0, 310.0, 6));
    room = add_relic(room, make_relic(1, "Seed of Rain", 1030.0, 305.0, "Restores forgotten gardens."));
    room = add_enemy(room, make_enemy(20, "thornling", 680.0, 430.0, 30.0, 32.0, 24, 9, 620.0, 840.0, "#66cc66"));
    room = add_enemy(room, make_enemy(21, "mirror wasp", 370.0, 420.0, 26.0, 24.0, 18, 8, 250.0, 540.0, "#aaff55"));
    room = add_door(room, make_door(20, 20.0, 488.0, 1, 1140.0, 420.0, false));
    room = add_door(room, make_door(21, 1210.0, 488.0, 3, 70.0, 420.0, true));
    return room;
}

