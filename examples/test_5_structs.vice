data Person {
    name: string => "Unknown";
    age: int => 0;
}

data Company {
    boss: Person => Person(name => "Boss", age => 50);
    employees: int => 10;
}

fn struct_test() -> bool {
    let mut p => Person(name => "Slodziak", age => 20);
    if (p.name != "Slodziak" || p.age != 20) {
        return false;
    }
    
    p.age = 21;
    if (p.age != 21) {
        return false;
    }
    
    let mut c => Company(boss => p, employees => 5);
    if (c.boss.name != "Slodziak" || c.employees != 5) {
        return false;
    }
    
    c.boss.age = 22;
    if (c.boss.age != 22) {
        return false;
    }
    
    return true;
}

fn main() {
    output <- "Running test 5 (Structs)...";
    let res => struct_test();
    if (res) {
        output <- "Test 5 Passed!";
    } else {
        error() <- "Test 5 Failed!";
    }
}
