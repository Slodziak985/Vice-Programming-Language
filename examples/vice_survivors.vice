# ---------------------------------------------------------
# Update Logic: Playing
# ---------------------------------------------------------
fn update_player(mut game: Game, dt: float, dx: float, dy: float) -> Game {
    let mut p => game.player;
    
    let move => Vec2(dx, dy).norm();
    p.pos = p.pos.add(move.mul(p.speed * dt));
    
    # Camera follows player perfectly
    game.camera.x = p.pos.x - 600.0;
    game.camera.y = p.pos.y - 400.0;
    
    # Weapons Fire
    let now => time.now_ms();
    
    # Whip logic (every 1.5s)
    if (p.weapon_whip > 0) {
        if (now - p.last_whip > 1500 - (p.weapon_whip * 100)) {
            p.last_whip = now;
            # Spawn whip projectiles left and right
            game.projs.push(Projectile(p.pos, Vec2(1.0, 0.0), 400.0, 10 + p.weapon_whip * 5, 200, 1));
            game.projs.push(Projectile(p.pos, Vec2(-1.0, 0.0), 400.0, 10 + p.weapon_whip * 5, 200, 1));
        }
    }
    
    # Magic logic (every 0.8s)
    if (p.weapon_magic > 0) {
        if (now - p.last_magic > 800 - (p.weapon_magic * 50)) {
            p.last_magic = now;
            # Find nearest enemy
            let mut best_dist => 99999.0;
            let mut target => Vec2(0.0, 0.0);
            let mut found => false;
            
            # Massive loop test
            for i in 0..len(game.enemies) {
                let e => game.enemies[i];
                let d => dist_sq(p.pos, e.pos);
                if (d < best_dist) {
                    best_dist = d;
                    target = e.pos;
                    found = true;
                }
            }
            
            if (found) {
                let dir => target.sub(p.pos).norm();
                game.projs.push(Projectile(p.pos, dir, 500.0, 5 + p.weapon_magic * 3, 1000, 2));
            }
        }
    }
    
    game.player = p;
    return game;
}

fn update_enemies(mut game: Game, dt: float) -> Game {
    let p_pos => game.player.pos;
    let mut updated_enemies: Enemy[] => [];
    for i in 0..len(game.enemies) {
        let mut e => game.enemies[i];
        let dir => p_pos.sub(e.pos).norm();
        e.pos = e.pos.add(dir.mul(e.speed * dt));
        
        # Player Collision
        if (dist_sq(p_pos, e.pos) < 900.0) {
            game.player.hp -= e.damage;
            if (game.player.hp <= 0) {
                game.state = AppState.GameOver;
            }
            # Bounce back slightly
            e.pos = e.pos.sub(dir.mul(50.0));
        }
        
        # Dead check
        if (e.hp <= 0) {
            game.player.kills += 1;
            game.score += e.max_hp;
            
            # Drop Gem
            game.gems.push(Gem(e.pos, 10));
            
            # Explosion Particles
            for p in 0..5 {
                let rx => random.float() * 2.0 - 1.0;
                let ry => random.float() * 2.0 - 1.0;
                game.particles.push(Particle(e.pos, Vec2(rx, ry).norm(), 300, "#ff0000"));
            }
            
        } else {
        }
    }
    return game;
}

fn update_projectiles(mut game: Game, dt: float) -> Game {
    let mut updated_projs: Projectile[] => [];
    for i in 0..len(game.projs) {
        let mut p => game.projs[i];
        p.pos = p.pos.add(p.dir.mul(p.speed * dt));
        p.life -= to_int(dt * 1000.0);
        
        let mut hit => false;
        
        # Check collision with enemies (heavy loop)
        for j in 0..len(game.enemies) {
            let mut e => game.enemies[j];
            if (dist_sq(p.pos, e.pos) < 1600.0) {
                e.hp -= p.damage;
                hit = true;
                
                # Hit particles
                game.particles.push(Particle(p.pos, p.dir.mul(-1.0), 150, "#ffffff"));
            }
            game.enemies[j] = e;
        }
        
        if (!(p.life <= 0 || hit)) {
            updated_projs.push(p);
        }
    }
    game.projs = updated_projs;
    return game;
}

fn update_gems(mut game: Game, dt: float) -> Game {
    let mut p => game.player;
    let mut updated_gems: Gem[] => [];
    for i in 0..len(game.gems) {
        let mut g => game.gems[i];
        let d => dist_sq(p.pos, g.pos);
        
        # Magnet effect (150 squared)
        if (d < 22500.0) {
            let dir => p.pos.sub(g.pos).norm();
            g.pos = g.pos.add(dir.mul(400.0 * dt));
        }
        
        if (dist_sq(p.pos, g.pos) < 400.0) {
            p.xp += g.value;
            game.score += 5;
            if (p.xp >= p.next_xp) {
                p.level += 1;
                p.xp = 0;
                p.next_xp = p.next_xp + 50 + (p.level * 20);
                game.state = AppState.LevelUp;
            }
        } else {
            updated_gems.push(g);
        }
    }
    game.gems = updated_gems;
    game.player = p;
    return game;
}

fn update_particles(mut game: Game, dt: float) -> Game {
    let mut updated_particles: Particle[] => [];
    for i in 0..len(game.particles) {
        let mut p => game.particles[i];
        p.pos = p.pos.add(p.dir.mul(100.0 * dt));
        p.life -= to_int(dt * 1000.0);
        if (!(p.life <= 0)) {
            updated_particles.push(p);
        }
    }
    game.particles = updated_particles;
    return game;
}

fn spawn_enemies(mut game: Game) -> Game {
    let now => time.now_ms();
    if (now - game.last_spawn > 1000) {
        game.last_spawn = now;
        
        # Spawn ring of enemies
        let count => 5 + (game.time_survived / 10);
        let radius => 800.0;
        
        for i in 0..count {
            let mut sx => game.player.pos.x + random.float() * 2000.0 - 1000.0;
            let mut sy => game.player.pos.y + random.float() * 2000.0 - 1000.0;
            # Push away from center if too close
            if (dist_sq(game.player.pos, Vec2(sx, sy)) < 160000.0) {
                sx += 800.0;
            }
            let spawn_pos => Vec2(sx, sy);
            
            # Enemy progression
            let hp => 20 + game.time_survived;
            let spd => 50.0 + random.float() * 30.0;
            
            game.enemies.push(Enemy(spawn_pos, hp, hp, spd, 1, 5));
        }
    }
    return game;
}

# ---------------------------------------------------------
# Render Logic
# ---------------------------------------------------------
fn render_playing(game: Game) {
    let cam => game.camera;
    
    # Draw floor grid
    let grid_size => 100.0;
    let start_x => math.floor(cam.x / grid_size) * grid_size;
    let start_y => math.floor(cam.y / grid_size) * grid_size;
    
    for x in 0..14 {
        for y in 0..10 {
            let px => start_x + (to_float(x) * grid_size);
            let py => start_y + (to_float(y) * grid_size);
            
            # Checkerboard
            let c_x => to_int(px / grid_size);
            let c_y => to_int(py / grid_size);
            let mut color => "#113311";
            if ((c_x + c_y) - ((c_x + c_y)/2)*2 == 0) { color = "#1a401a"; }
            
            ui.draw_rect(
                pos => [to_int(px - cam.x), to_int(py - cam.y)],
                size => [to_int(grid_size), to_int(grid_size)],
                color => color
            );
        }
    }
    
    # Draw Gems
    for i in 0..len(game.gems) {
        let g => game.gems[i];
        ui.draw_rect(
            pos => [to_int(g.pos.x - cam.x) - 5, to_int(g.pos.y - cam.y) - 5],
            size => [10, 10],
            color => "#00ffff"
        );
    }
    
    # Draw Enemies
    for i in 0..len(game.enemies) {
        let e => game.enemies[i];
        ui.draw_rect(
            pos => [to_int(e.pos.x - cam.x) - 15, to_int(e.pos.y - cam.y) - 15],
            size => [30, 30],
            color => "#ff3333"
        );
        # Health bar
        let hp_pct => to_float(e.hp) / to_float(e.max_hp);
        ui.draw_rect(
            pos => [to_int(e.pos.x - cam.x) - 15, to_int(e.pos.y - cam.y) - 22],
            size => [to_int(30.0 * hp_pct), 4],
            color => "#00ff00"
        );
    }
    
    # Draw Projectiles
    for i in 0..len(game.projs) {
        let p => game.projs[i];
        let mut color => "#ffffff";
        if (p.type_id == 1) { color = "#ffffff"; } # Whip
        if (p.type_id == 2) { color = "#ff00ff"; } # Magic
        
        ui.draw_rect(
            pos => [to_int(p.pos.x - cam.x) - 8, to_int(p.pos.y - cam.y) - 8],
            size => [16, 16],
            color => color
        );
    }
    
    # Draw Particles
    for i in 0..len(game.particles) {
        let p => game.particles[i];
        ui.draw_rect(
            pos => [to_int(p.pos.x - cam.x) - 2, to_int(p.pos.y - cam.y) - 2],
            size => [4, 4],
            color => p.color
        );
    }
    
    # Draw Player
    let p => game.player;
    ui.draw_rect(
        pos => [to_int(p.pos.x - cam.x) - 20, to_int(p.pos.y - cam.y) - 20],
        size => [40, 40],
        color => "#3366ff"
    );
    
    # UI OVERLAY
    # Top Bar background
    ui.draw_rect(pos => [0, 0], size => [1200, 50], color => "#000000bb");
    
    # HP Bar
    ui.text(pos => [20, 15], text => "HP: ${p.hp}/${p.max_hp}", color => "#ff5555");
    
    # XP Bar
    ui.text(pos => [300, 15], text => "Level ${p.level} [XP: ${p.xp}/${p.next_xp}]", color => "#55ffff");
    
    # Stats
    ui.text(pos => [600, 15], text => "Kills: ${p.kills} | Score: ${game.score}", color => "#ffffff");
    ui.text(pos => [900, 15], text => "Time: ${game.time_survived}s", color => "#ffff55");
}

fn render_menu(mut game: Game) -> Game {
    ui.draw_rect(pos => [0, 0], size => [1200, 800], color => "#110022");
    ui.text(pos => [350, 200], text => "VICE SURVIVORS", color => "#ff00ff");
    ui.text(pos => [400, 250], text => "The Ultimate Engine Stress Test", color => "#aaaaaa");
    
    let mut btn_start: UiResponse => ui.button(id => "menu.start", pos => [500, 400], size => [200, 50], text => "Start Game", color => "#33aa33");
    if (btn_start.clicked) {
        game.state = AppState.Playing;
        game.player.hp = game.player.max_hp;
        game.last_spawn = time.now_ms();
    }
    return game;
}

fn render_game_over(mut game: Game) -> Game {
    ui.draw_rect(pos => [0, 0], size => [1200, 800], color => "#330000");
    ui.text(pos => [450, 300], text => "GAME OVER", color => "#ff0000");
    ui.text(pos => [450, 350], text => "Score: ${game.score}", color => "#ffffff");
    ui.text(pos => [450, 380], text => "Survived: ${game.time_survived}s", color => "#aaaaaa");
    
    let mut btn_menu: UiResponse => ui.button(id => "gameover.menu", pos => [500, 500], size => [200, 50], text => "Menu", color => "#3333aa");
    if (btn_menu.clicked) {
        let fresh => init_game();
        game.state = fresh.state;
        game.player = fresh.player;
        game.enemies = fresh.enemies;
        game.gems = fresh.gems;
        game.projs = fresh.projs;
        game.particles = fresh.particles;
        game.score = 0;
        game.time_survived = 0;
    }
    return game;
}

fn render_level_up(mut game: Game) -> Game {
    # Darken background
    render_playing(game);
    ui.draw_rect(pos => [0, 0], size => [1200, 800], color => "#000000aa");
    
    ui.text(pos => [450, 200], text => "LEVEL UP! (Lv ${game.player.level})", color => "#ffff00");
    
    let mut btn_whip: UiResponse => ui.button(id => "levelup.whip", pos => [400, 300], size => [400, 60], text => "+1 Whip Level", color => "#aa3333");
    if (btn_whip.clicked) {
        game.player.weapon_whip += 1;
        game.state = AppState.Playing;
    }
    
    let mut btn_magic: UiResponse => ui.button(id => "levelup.magic", pos => [400, 400], size => [400, 60], text => "+1 Magic Missile", color => "#cc33cc");
    if (btn_magic.clicked) {
        game.player.weapon_magic += 1;
        game.state = AppState.Playing;
    }
    
    let mut btn_heal: UiResponse => ui.button(id => "levelup.heal", pos => [400, 500], size => [400, 60], text => "Heal 50 HP", color => "#33aa33");
    if (btn_heal.clicked) {
        game.player.hp += 50;
        if (game.player.hp > game.player.max_hp) { game.player.hp = game.player.max_hp; }
        game.state = AppState.Playing;
    }
    return game;
}

# ---------------------------------------------------------
# Main Game Loop
# ---------------------------------------------------------
@entry
fn main() {
    let mut win: Window => ui.window(
        title => "Vice Survivors",
        size => [1200, 800],
        color => "#000000"
    );

    let mut game => init_game();
    let mut last_time => time.now_ms();
    let mut start_time => time.now_ms();
    let mut game_clock => 0;

    while (ui.frame(win)) {
        
        let current_time => time.now_ms();
        let dt_ms => current_time - last_time;
        last_time = current_time;
        
        # Cap dt to avoid huge jumps
        let mut dt => to_float(dt_ms) / 1000.0;
        if (dt > 0.1) { dt = 0.1; }

        match game.state {
            AppState.Menu => {
                game = render_menu(game);
                start_time = time.now_ms();
            }
            AppState.Playing => {
                game_clock += dt_ms;
                game.time_survived = game_clock / 1000;
                
                let mut dx => 0.0;
                let mut dy => 0.0;
                if (ui.is_key_pressed("ArrowUp")) { dy = -1.0; }
                if (ui.is_key_pressed("ArrowDown")) { dy = 1.0; }
                if (ui.is_key_pressed("ArrowLeft")) { dx = -1.0; }
                if (ui.is_key_pressed("ArrowRight")) { dx = 1.0; }

                game = update_player(game, dt, dx, dy);
                game = spawn_enemies(game);
                game = update_enemies(game, dt);
                game = update_projectiles(game, dt);
                game = update_gems(game, dt);
                game = update_particles(game, dt);
                
                render_playing(game);
            }
            AppState.LevelUp => {
                game = render_level_up(game);
                # Pause start_time offset so time survived doesn't increase
                start_time += dt_ms;
            }
            AppState.GameOver => {
                game = render_game_over(game);
                game_clock = 0;
            }
        }
    }
}
