# VICE SURVIVORS - Mega Engine Stress Test
# Lines: ~1500
# Author: Vice Engine AI
# Purpose: Pushing Vice to its limits with arrays, references, math, and rendering.

# ---------------------------------------------------------
# Core Math & Geometry
# ---------------------------------------------------------
data Vec2 { 
    x: float => 0.0; 
    y: float => 0.0; 
}

impl Vec2 {
    fn add(self, other: Vec2) -> Vec2 { return Vec2(self.x + other.x, self.y + other.y); }
    fn sub(self, other: Vec2) -> Vec2 { return Vec2(self.x - other.x, self.y - other.y); }
    fn mul(self, scalar: float) -> Vec2 { return Vec2(self.x * scalar, self.y * scalar); }
    fn mag_sq(self) -> float { return self.x * self.x + self.y * self.y; }
    fn norm(self) -> Vec2 {
        let m_sq => self.mag_sq();
        if (m_sq == 0.0) { return Vec2(0.0, 0.0); }
        # Approximate normalization without sqrt (manhattan distance fallback)
        let approx_mag => math.abs(self.x) + math.abs(self.y);
        return Vec2(self.x / approx_mag, self.y / approx_mag);
    }
}

fn dist_sq(a: Vec2, b: Vec2) -> float {
    let dx => a.x - b.x;
    let dy => a.y - b.y;
    return dx * dx + dy * dy;
}

# ---------------------------------------------------------
# Enums and Constants
# ---------------------------------------------------------
enum AppState { Menu, Playing, LevelUp, GameOver }

# ---------------------------------------------------------
# Entities
# ---------------------------------------------------------
data Player {
    pos: Vec2 => Vec2(0.0, 0.0);
    hp: int => 100;
    max_hp: int => 100;
    speed: float => 200.0;
    level: int => 1;
    xp: int => 0;
    next_xp: int => 100;
    kills: int => 0;
    weapon_whip: int => 1;
    weapon_aura: int => 0;
    weapon_magic: int => 0;
    last_whip: int => 0;
    last_magic: int => 0;
}

data Enemy {
    pos: Vec2 => Vec2(0.0, 0.0);
    hp: int => 20;
    max_hp: int => 20;
    speed: float => 50.0;
    type_id: int => 1;
    damage: int => 5;
}

data Gem {
    pos: Vec2 => Vec2(0.0, 0.0);
    value: int => 10;
}

data Projectile {
    pos: Vec2 => Vec2(0.0, 0.0);
    dir: Vec2 => Vec2(1.0, 0.0);
    speed: float => 400.0;
    damage: int => 10;
    life: int => 1000;
    type_id: int => 1;
}

data Particle {
    pos: Vec2 => Vec2(0.0, 0.0);
    dir: Vec2 => Vec2(0.0, -1.0);
    life: int => 300;
    color: string => "#ffffff";
}

data Game {
    state: AppState => AppState.Menu;
    player: Player => Player(Vec2(600.0, 400.0), 100, 100, 200.0, 1, 0, 100, 0, 1, 0, 0, 0, 0);
    enemies: Enemy[] => [];
    gems: Gem[] => [];
    projs: Projectile[] => [];
    particles: Particle[] => [];
    camera: Vec2 => Vec2(0.0, 0.0);
    score: int => 0;
    time_survived: int => 0;
    last_spawn: int => 0;
}

