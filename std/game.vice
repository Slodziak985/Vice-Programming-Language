data GameVec2 {
    x: float => 0.0;
    y: float => 0.0;
}

data GameRect {
    x: float => 0.0;
    y: float => 0.0;
    width: float => 16.0;
    height: float => 16.0;
}

data GameCamera {
    x: float => 0.0;
    y: float => 0.0;
    width: int => 800;
    height: int => 600;
}

data GameTime {
    last_ms: int => 0;
    delta: float => 0.0;
    elapsed_ms: int => 0;
}

data GameSprite {
    path: string => "";
    x: int => 0;
    y: int => 0;
    width: int => 16;
    height: int => 16;
}

data GameAnimation {
    frame_width: int => 16;
    frame_height: int => 16;
    frame_count: int => 1;
    fps: int => 8;
}

fn game_vec2(x: float, y: float) -> GameVec2 {
    mut value => GameVec2();
    value.x = x;
    value.y = y;
    return value;
}

fn game_rect(x: float, y: float, width: float, height: float) -> GameRect {
    mut rect => GameRect();
    rect.x = x;
    rect.y = y;
    rect.width = width;
    rect.height = height;
    return rect;
}

fn game_camera(width: int, height: int) -> GameCamera {
    mut camera => GameCamera();
    camera.width = width;
    camera.height = height;
    return camera;
}

fn game_rects_overlap(a: GameRect, b: GameRect) -> bool {
    if (a.x + a.width <= b.x) { return false; }
    if (b.x + b.width <= a.x) { return false; }
    if (a.y + a.height <= b.y) { return false; }
    if (b.y + b.height <= a.y) { return false; }
    return true;
}

fn game_time_start() -> GameTime {
    let now => time.now_ms();
    mut timer => GameTime();
    timer.last_ms = now;
    timer.delta = 0.0;
    timer.elapsed_ms = 0;
    return timer;
}

fn game_time_tick(mut timer: GameTime) -> GameTime {
    let now => time.now_ms();
    let dt_ms => now - timer.last_ms;
    timer.last_ms = now;
    timer.elapsed_ms += dt_ms;
    timer.delta = to_float(dt_ms) / 1000.0;
    if (timer.delta > 0.05) {
        timer.delta = 0.05;
    }
    return timer;
}

fn game_camera_follow(mut camera: GameCamera, target: GameVec2) -> GameCamera {
    camera.x = target.x - (to_float(camera.width) / 2.0);
    camera.y = target.y - (to_float(camera.height) / 2.0);
    return camera;
}

fn game_world_to_screen(pos: GameVec2, camera: GameCamera) -> GameVec2 {
    return game_vec2(pos.x - camera.x, pos.y - camera.y);
}

fn game_draw_rect_world(rect: GameRect, camera: GameCamera, color: string) -> bool {
    let screen => game_world_to_screen(game_vec2(rect.x, rect.y), camera);
    return game2d.rect(
        pos => [to_int(screen.x), to_int(screen.y)],
        size => [to_int(rect.width), to_int(rect.height)],
        color => color
    );
}

fn game_draw_sprite_world(sprite: GameSprite, pos: GameVec2, camera: GameCamera) -> bool {
    let screen => game_world_to_screen(pos, camera);
    return game2d.sprite(
        path => sprite.path,
        pos => [to_int(screen.x), to_int(screen.y)],
        size => [sprite.width, sprite.height],
        src_pos => [sprite.x, sprite.y],
        src_size => [sprite.width, sprite.height]
    );
}

fn game_animation_frame(animation: GameAnimation, elapsed_ms: int) -> int {
    if (animation.frame_count <= 1) {
        return 0;
    }
    let frame_ms => 1000 / animation.fps;
    return (elapsed_ms / frame_ms) - ((elapsed_ms / frame_ms) / animation.frame_count) * animation.frame_count;
}
