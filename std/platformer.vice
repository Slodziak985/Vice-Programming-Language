use "physics2d.vice";

data PlatformerInput {
    left: bool => false;
    right: bool => false;
    jump: bool => false;
}

data PlatformerPlayer {
    body: PhysicsBody => PhysicsBody();
    speed: float => 260.0;
    jump_speed: float => 560.0;
    color: string => "#55ffff";
}

data PlatformerLevel {
    width: int => 1280;
    height: int => 720;
    floor_y: float => 520.0;
    platforms: GameRect[] => [];
}

fn platformer_input() -> PlatformerInput {
    let left => ui.is_key_pressed("ArrowLeft") || ui.is_key_pressed("KeyA");
    let right => ui.is_key_pressed("ArrowRight") || ui.is_key_pressed("KeyD");
    let jump => ui.is_key_pressed("Space") || ui.is_key_pressed("ArrowUp") || ui.is_key_pressed("KeyW");
    mut controls => PlatformerInput();
    controls.left = left;
    controls.right = right;
    controls.jump = jump;
    return controls;
}

fn platformer_default_level() -> PlatformerLevel {
    let mut platforms: GameRect[] => [];
    platforms.push(game_rect(180.0, 430.0, 180.0, 24.0));
    platforms.push(game_rect(460.0, 360.0, 220.0, 24.0));
    platforms.push(game_rect(760.0, 300.0, 180.0, 24.0));
    mut level => PlatformerLevel();
    level.width = 1280;
    level.height = 720;
    level.floor_y = 560.0;
    level.platforms = platforms;
    return level;
}

fn platformer_default_player() -> PlatformerPlayer {
    mut player => PlatformerPlayer();
    player.body = physics_body(game_vec2(80.0, 420.0), game_vec2(30.0, 44.0));
    player.speed = 260.0;
    player.jump_speed = 560.0;
    player.color = "#55ffff";
    return player;
}

fn platformer_update_player(mut player: PlatformerPlayer, controls: PlatformerInput, level: PlatformerLevel, world: PhysicsWorld, dt: float) -> PlatformerPlayer {
    let previous_y => player.body.pos.y;

    player.body.velocity.x = 0.0;
    if (controls.left) {
        player.body.velocity.x = 0.0 - player.speed;
    }
    if (controls.right) {
        player.body.velocity.x = player.speed;
    }
    if (controls.jump && player.body.grounded) {
        player.body.velocity.y = 0.0 - player.jump_speed;
        player.body.grounded = false;
    }

    player.body = physics_body_step(player.body, world, dt);
    player.body = physics_resolve_floor(player.body, level.floor_y);
    player.body = physics_resolve_platforms(player.body, level.platforms, previous_y);

    if (player.body.pos.x < 0.0) {
        player.body.pos.x = 0.0;
    }
    if (player.body.pos.x + player.body.size.x > to_float(level.width)) {
        player.body.pos.x = to_float(level.width) - player.body.size.x;
    }
    return player;
}

fn platformer_draw_level(level: PlatformerLevel, camera: GameCamera) {
    game_draw_rect_world(
        game_rect(0.0, level.floor_y, to_float(level.width), 64.0),
        camera,
        "#27343a"
    );

    for i in 0..(len(level.platforms) - 1) {
        game_draw_rect_world(level.platforms[i], camera, "#58707c");
    }
}

fn platformer_draw_player(player: PlatformerPlayer, camera: GameCamera) {
    game_draw_rect_world(physics_body_rect(player.body), camera, player.color);
}
