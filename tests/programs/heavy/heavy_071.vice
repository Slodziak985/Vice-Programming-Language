# Heavy Test 071: Relational DB Engine with Hash Index & Join 71
data Row71 {
    id: int,
    user_id: int,
    amount: float,
    status: string
}

data UserRow71 {
    id: int,
    name: string,
    role: string
}

data DatabaseEngine71 {
    users: array,
    orders: array,
    user_index: map
}

fn db_new() -> DatabaseEngine71 {
    return DatabaseEngine71([], [], {});
}

fn db_insert_user(db: DatabaseEngine71, user: UserRow71) -> DatabaseEngine71 {
    mut users = array.push(db.users, user);
    mut idx = map.set(db.user_index, string.from_int(user.id), user.name);
    return DatabaseEngine71(users, db.orders, idx);
}

fn db_insert_order(db: DatabaseEngine71, order: Row71) -> DatabaseEngine71 {
    mut orders = array.push(db.orders, order);
    return DatabaseEngine71(db.users, orders, db.user_index);
}

fn db_join_orders_with_users(db: DatabaseEngine71) -> array {
    mut joined = [];
    for order in db.orders {
        mut user_id_str = string.from_int(order.user_id);
        if map.contains_key(db.user_index, user_id_str) {
            mut user_name = map.get(db.user_index, user_id_str, "Unknown");
            mut record = {
                "order_id": order.id,
                "user_name": user_name,
                "amount": order.amount,
                "status": order.status
            };
            joined = array.push(joined, record);
        }
    }
    return joined;
}

fn db_aggregate_status(records: array, target_status: string) -> float {
    mut total = 0.0;
    for rec in records {
        mut s = map.get(rec, "status", "");
        if s == target_status {
            mut amt = map.get(rec, "amount", 0.0);
            total = total + amt;
        }
    }
    return total;
}

fn main() {
    mut db = db_new();
    
    # Insert users
    db = db_insert_user(db, UserRow71(1, "Alice", "admin"));
    db = db_insert_user(db, UserRow71(2, "Bob", "developer"));
    db = db_insert_user(db, UserRow71(3, "Charlie", "tester"));
    
    # Insert orders
    db = db_insert_order(db, Row71(101, 1, 171.0, "PAID"));
    db = db_insert_order(db, Row71(102, 2, 321.0, "PENDING"));
    db = db_insert_order(db, Row71(103, 1, 50.0, "PAID"));
    db = db_insert_order(db, Row71(104, 3, 300.0, "PAID"));
    
    mut joined_records = db_join_orders_with_users(db);
    mut paid_total = db_aggregate_status(joined_records, "PAID");
    mut expected_paid = 221.0 + 300.0;
    
    if array.len(joined_records) == 4 and paid_total > expected_paid - 0.01 and paid_total < expected_paid + 0.01 {
        output <- "PASS";
    } else {
        output <- "FAIL";
    }
}