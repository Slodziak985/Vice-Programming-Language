# Heavy Test 089: In-Memory Virtual File System (VFS) 89
data VfsNode89 {
    id: int,
    name: string,
    is_dir: bool,
    parent_id: int,
    content: string
}

data VirtualFileSystem89 {
    nodes: array,
    next_id: int
}

fn vfs_new() -> VirtualFileSystem89 {
    mut root = VfsNode89(0, "/", true, -1, "");
    return VirtualFileSystem89([root], 1);
}

fn vfs_mkdir(vfs: VirtualFileSystem89, parent_id: int, name: string) -> VirtualFileSystem89 {
    mut nid = vfs.next_id;
    mut dir_node = VfsNode89(nid, name, true, parent_id, "");
    mut nodes = array.push(vfs.nodes, dir_node);
    return VirtualFileSystem89(nodes, nid + 1);
}

fn vfs_write_file(vfs: VirtualFileSystem89, parent_id: int, name: string, content: string) -> VirtualFileSystem89 {
    mut nid = vfs.next_id;
    mut file_node = VfsNode89(nid, name, false, parent_id, content);
    mut nodes = array.push(vfs.nodes, file_node);
    return VirtualFileSystem89(nodes, nid + 1);
}

fn vfs_read_file(vfs: VirtualFileSystem89, parent_id: int, name: string) -> string {
    for node in vfs.nodes {
        if node.parent_id == parent_id and node.name == name and !node.is_dir {
            return node.content;
        }
    }
    return "";
}

fn main() {
    mut fs = vfs_new();
    fs = vfs_mkdir(fs, 0, "etc");
    fs = vfs_mkdir(fs, 0, "var");
    
    fs = vfs_write_file(fs, 1, "config.json", "{\"port\": 8080}");
    fs = vfs_write_file(fs, 2, "log.txt", "system initialized for test_89");
    
    mut read_cfg = vfs_read_file(fs, 1, "config.json");
    mut read_log = vfs_read_file(fs, 2, "log.txt");
    mut read_missing = vfs_read_file(fs, 1, "secret.key");
    
    mut ok_cfg = (read_cfg == "{\"port\": 8080}");
    mut ok_log = string.contains(read_log, "test_89");
    mut ok_miss = (read_missing == "");
    
    if ok_cfg and ok_log and ok_miss and array.len(fs.nodes) == 5 {
        output <- "PASS";
    } else {
        output <- "FAIL";
    }
}