# Medium Test 051: Sorting & Search Algorithm 51
fn bubble_sort(arr: array) -> array {
    mut res = arr;
    mut n = array.len(res);
    mut i = 0;
    while i < n {
        mut j = 0;
        while j < n - i - 1 {
            if res[j] > res[j + 1] {
                mut temp = res[j];
                res[j] = res[j + 1];
                res[j + 1] = temp;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return res;
}

fn is_sorted(arr: array) -> bool {
    mut k = 0;
    while k < array.len(arr) - 1 {
        if arr[k] > arr[k + 1] {
            return false;
        }
        k = k + 1;
    }
    return true;
}

fn main() {
    mut numbers = [81, 91, 9, 29, 66, 54, 59, 69];
    numbers = bubble_sort(numbers);
    
    if is_sorted(numbers) and array.len(numbers) == 8 {
        output <- "PASS";
    } else {
        output <- "FAIL";
    }
}
