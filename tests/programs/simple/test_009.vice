# Test 009: Recursive Fibonacci
fn fib(n: int) -> int {
    if n <= 0 {
        return 0;
    }
    if n == 1 {
        return 1;
    }
    return fib(n - 1) + fib(n - 2);
}

fn main() {
    mut f7 = fib(7);
    # Fib(7) is 13
    if f7 == 13 {
        output <- "PASS";
    } else {
        output <- "FAIL";
    }
}
