# Test 011: Mathematical series step 11
fn main() {
    mut total = 0;
    mut k = 1;
    while k <= 5 {
        total = total + (k * k + 11);
        k = k + 1;
    }
    # 1+4+9+16+25 = 55 + 5*11
    mut expected = 55 + (5 * 11);
    if total == expected {
        output <- "PASS";
    } else {
        output <- "FAIL";
    }
}
