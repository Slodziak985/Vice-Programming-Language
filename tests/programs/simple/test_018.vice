# Test 018: Custom data structure 18
data Box18 {
    width: int,
    height: int,
    depth: int
}

fn volume(b: Box18) -> int {
    return b.width * b.height * b.depth;
}

fn main() {
    mut b = Box18(10, 3, 4);
    mut v = volume(b);
    if v == 120 {
        output <- "PASS";
    } else {
        output <- "FAIL";
    }
}
