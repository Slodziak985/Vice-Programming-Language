# Test 021: Mathematical series step 21
fn main() {
    mut total = 0;
    mut k = 1;
    while k <= 5 {
        total = total + (k * k + 21);
        k = k + 1;
    }
    # 1+4+9+16+25 = 55 + 5*21
    mut expected = 55 + (5 * 21);
    if total == expected {
        output <- "PASS";
    } else {
        output <- "FAIL";
    }
}
