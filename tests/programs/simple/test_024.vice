# Test 024: Frequency counting in map 24
fn main() {
    mut m = {};
    m = map.set(m, "count_24", 240);
    m = map.set(m, "multiplier", 3);
    mut count = map.get(m, "count_24", 0);
    mut mult = map.get(m, "multiplier", 1);
    mut res = count * mult;
    if res == 720 {
        output <- "PASS";
    } else {
        output <- "FAIL";
    }
}
