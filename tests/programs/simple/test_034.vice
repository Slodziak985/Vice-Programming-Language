# Test 034: Frequency counting in map 34
fn main() {
    mut m = {};
    m = map.set(m, "count_34", 340);
    m = map.set(m, "multiplier", 3);
    mut count = map.get(m, "count_34", 0);
    mut mult = map.get(m, "multiplier", 1);
    mut res = count * mult;
    if res == 1020 {
        output <- "PASS";
    } else {
        output <- "FAIL";
    }
}
