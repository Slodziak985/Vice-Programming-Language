# Test 035: Crypto SHA256 integrity check 35
fn main() {
    mut h = crypto.sha256("vice_input_data_35");
    mut l = string.len(h);
    mut b64 = crypto.base64_encode("test_35");
    mut decoded = crypto.base64_decode(b64);
    if l == 64 and decoded == "test_35" {
        output <- "PASS";
    } else {
        output <- "FAIL";
    }
}
