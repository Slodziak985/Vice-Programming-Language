# Test 038: Custom data structure 38
data Box38 {
    width: int,
    height: int,
    depth: int
}

fn volume(b: Box38) -> int {
    return b.width * b.height * b.depth;
}

fn main() {
    mut b = Box38(10, 3, 4);
    mut v = volume(b);
    if v == 120 {
        output <- "PASS";
    } else {
        output <- "FAIL";
    }
}
