# Test 042: Array filtering and transformation 42
fn main() {
    mut src = [42, 43, 44, 45, 46];
    mut doubled = [];
    for item in src {
        doubled = array.push(doubled, item * 2);
    }
    mut first = array.first(doubled);
    mut last = array.last(doubled);
    if first == 84 and last == 92 {
        output <- "PASS";
    } else {
        output <- "FAIL";
    }
}
