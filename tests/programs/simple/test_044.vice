# Test 044: Frequency counting in map 44
fn main() {
    mut m = {};
    m = map.set(m, "count_44", 440);
    m = map.set(m, "multiplier", 3);
    mut count = map.get(m, "count_44", 0);
    mut mult = map.get(m, "multiplier", 1);
    mut res = count * mult;
    if res == 1320 {
        output <- "PASS";
    } else {
        output <- "FAIL";
    }
}
