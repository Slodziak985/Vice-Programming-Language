# Test 045: Crypto SHA256 integrity check 45
fn main() {
    mut h = crypto.sha256("vice_input_data_45");
    mut l = string.len(h);
    mut b64 = crypto.base64_encode("test_45");
    mut decoded = crypto.base64_decode(b64);
    if l == 64 and decoded == "test_45" {
        output <- "PASS";
    } else {
        output <- "FAIL";
    }
}
