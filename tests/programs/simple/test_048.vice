# Test 048: Custom data structure 48
data Box48 {
    width: int,
    height: int,
    depth: int
}

fn volume(b: Box48) -> int {
    return b.width * b.height * b.depth;
}

fn main() {
    mut b = Box48(10, 3, 4);
    mut v = volume(b);
    if v == 120 {
        output <- "PASS";
    } else {
        output <- "FAIL";
    }
}
