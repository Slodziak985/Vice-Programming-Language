# Test 049: SQLite in-memory execution 49
fn main() {
    mut db = sqlite.open(":memory:");
    sqlite.execute(db, "CREATE TABLE t (val INT);", []);
    sqlite.execute(db, "INSERT INTO t VALUES (?);", [343]);
    mut rows = sqlite.query(db, "SELECT val FROM t;", []);
    sqlite.close(db);
    if array.len(rows) == 1 {
        output <- "PASS";
    } else {
        output <- "FAIL";
    }
}
