# Test 052: Array filtering and transformation 52
fn main() {
    mut src = [52, 53, 54, 55, 56];
    mut doubled = [];
    for item in src {
        doubled = array.push(doubled, item * 2);
    }
    mut first = array.first(doubled);
    mut last = array.last(doubled);
    if first == 104 and last == 112 {
        output <- "PASS";
    } else {
        output <- "FAIL";
    }
}
