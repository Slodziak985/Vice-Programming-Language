# Test 058: Custom data structure 58
data Box58 {
    width: int,
    height: int,
    depth: int
}

fn volume(b: Box58) -> int {
    return b.width * b.height * b.depth;
}

fn main() {
    mut b = Box58(10, 3, 4);
    mut v = volume(b);
    if v == 120 {
        output <- "PASS";
    } else {
        output <- "FAIL";
    }
}
