# Test 064: Frequency counting in map 64
fn main() {
    mut m = {};
    m = map.set(m, "count_64", 640);
    m = map.set(m, "multiplier", 3);
    mut count = map.get(m, "count_64", 0);
    mut mult = map.get(m, "multiplier", 1);
    mut res = count * mult;
    if res == 1920 {
        output <- "PASS";
    } else {
        output <- "FAIL";
    }
}
