# Test 065: Crypto SHA256 integrity check 65
fn main() {
    mut h = crypto.sha256("vice_input_data_65");
    mut l = string.len(h);
    mut b64 = crypto.base64_encode("test_65");
    mut decoded = crypto.base64_decode(b64);
    if l == 64 and decoded == "test_65" {
        output <- "PASS";
    } else {
        output <- "FAIL";
    }
}
