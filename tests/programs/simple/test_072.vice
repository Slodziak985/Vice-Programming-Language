# Test 072: Array filtering and transformation 72
fn main() {
    mut src = [72, 73, 74, 75, 76];
    mut doubled = [];
    for item in src {
        doubled = array.push(doubled, item * 2);
    }
    mut first = array.first(doubled);
    mut last = array.last(doubled);
    if first == 144 and last == 152 {
        output <- "PASS";
    } else {
        output <- "FAIL";
    }
}
