# Test 074: Frequency counting in map 74
fn main() {
    mut m = {};
    m = map.set(m, "count_74", 740);
    m = map.set(m, "multiplier", 3);
    mut count = map.get(m, "count_74", 0);
    mut mult = map.get(m, "multiplier", 1);
    mut res = count * mult;
    if res == 2220 {
        output <- "PASS";
    } else {
        output <- "FAIL";
    }
}
