# Test 075: Crypto SHA256 integrity check 75
fn main() {
    mut h = crypto.sha256("vice_input_data_75");
    mut l = string.len(h);
    mut b64 = crypto.base64_encode("test_75");
    mut decoded = crypto.base64_decode(b64);
    if l == 64 and decoded == "test_75" {
        output <- "PASS";
    } else {
        output <- "FAIL";
    }
}
