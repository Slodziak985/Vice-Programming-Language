# Test 081: Mathematical series step 81
fn main() {
    mut total = 0;
    mut k = 1;
    while k <= 5 {
        total = total + (k * k + 81);
        k = k + 1;
    }
    # 1+4+9+16+25 = 55 + 5*81
    mut expected = 55 + (5 * 81);
    if total == expected {
        output <- "PASS";
    } else {
        output <- "FAIL";
    }
}
