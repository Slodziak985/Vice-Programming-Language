# Test 084: Frequency counting in map 84
fn main() {
    mut m = {};
    m = map.set(m, "count_84", 840);
    m = map.set(m, "multiplier", 3);
    mut count = map.get(m, "count_84", 0);
    mut mult = map.get(m, "multiplier", 1);
    mut res = count * mult;
    if res == 2520 {
        output <- "PASS";
    } else {
        output <- "FAIL";
    }
}
