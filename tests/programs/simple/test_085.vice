# Test 085: Crypto SHA256 integrity check 85
fn main() {
    mut h = crypto.sha256("vice_input_data_85");
    mut l = string.len(h);
    mut b64 = crypto.base64_encode("test_85");
    mut decoded = crypto.base64_decode(b64);
    if l == 64 and decoded == "test_85" {
        output <- "PASS";
    } else {
        output <- "FAIL";
    }
}
