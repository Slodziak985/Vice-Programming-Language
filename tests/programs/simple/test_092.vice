# Test 092: Array filtering and transformation 92
fn main() {
    mut src = [92, 93, 94, 95, 96];
    mut doubled = [];
    for item in src {
        doubled = array.push(doubled, item * 2);
    }
    mut first = array.first(doubled);
    mut last = array.last(doubled);
    if first == 184 and last == 192 {
        output <- "PASS";
    } else {
        output <- "FAIL";
    }
}
