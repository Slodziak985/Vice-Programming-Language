{
  "Entry function": {
    "prefix": "entry",
    "body": [
      "@entry",
      "fn main() {",
      "    $0",
      "}"
    ],
    "description": "Create a Vice entry point"
  },
  "Data declaration": {
    "prefix": "data",
    "body": [
      "data ${1:Name} {",
      "    ${2:field} : ${3:string} => ${4:\"value\"};",
      "}"
    ],
    "description": "Create a Vice data structure"
  },
  "For range": {
    "prefix": "forr",
    "body": [
      "for ${1:i} in ${2:1}..${3:10} {",
      "    $0",
      "}"
    ],
    "description": "Create a range loop"
  },
  "For each": {
    "prefix": "fore",
    "body": [
      "for ${1:item} in ${2:items} {",
      "    $0",
      "}"
    ],
    "description": "Create a collection loop"
  },
  "Output": {
    "prefix": "out",
    "body": [
      "output <- ${1:\"message\"};"
    ],
    "description": "Write to output"
  },
  "UI app": {
    "prefix": "uiapp",
    "body": [
      "@read -> @intent(\"APP_THEME\")",
      "data theme {",
      "    window_title : string => \"Vice App\";",
      "    bg_color     : string => \"#1a1a1a\";",
      "    accent       : string => \"#00ff88\";",
      "}",
      "",
      "@entry -> @intent(\"UI_ROOT\")",
      "fn main() {",
      "    mut win : Window => ui.create(",
      "        title => theme.window_title,",
      "        size  => [400, 300],",
      "        color => theme.bg_color",
      "    );",
      "",
      "    while (win : is_open) {",
      "        ui.rect(pos => [40, 40], size => [180, 90], color => theme.accent);",
      "        $0",
      "    }",
      "}"
    ],
    "description": "Create a Vice UI application skeleton"
  }
}
