{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Vice",
  "scopeName": "source.vice",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#attributes"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#function-declarations"
    },
    {
      "include": "#data-declarations"
    },
    {
      "include": "#calls"
    },
    {
      "include": "#properties"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.vice",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.number-sign.vice",
          "match": "#.*$"
        },
        {
          "name": "comment.line.double-slash.vice",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.vice",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.vice",
          "match": "\\\\."
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "entity.name.tag.attribute.vice",
          "match": "@[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.vice",
          "match": "\\b(if|else|while|for|in|return|match|break|continue|import)\\b"
        },
        {
          "name": "storage.type.vice",
          "match": "\\b(fn|let|mut|data)\\b"
        },
        {
          "name": "keyword.other.io.vice",
          "match": "\\b(output|input|error)\\b"
        },
        {
          "name": "constant.language.boolean.vice",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.vice",
          "match": "\\b(int|string|bool|Window|Button)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.vice",
          "match": "\\b(to_num|to_str|len)\\b(?=\\s*\\()"
        },
        {
          "name": "support.module.ui.vice",
          "match": "\\b(ui|math|fs|string|array|time|random|path|env|json)\\b(?=\\.)"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.vice",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    },
    "function-declarations": {
      "patterns": [
        {
          "name": "meta.function.declaration.vice",
          "match": "\\bfn\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "entity.name.function.vice"
            }
          }
        }
      ]
    },
    "data-declarations": {
      "patterns": [
        {
          "name": "meta.data.declaration.vice",
          "match": "\\bdata\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "entity.name.type.vice"
            }
          }
        }
      ]
    },
    "calls": {
      "patterns": [
        {
          "name": "entity.name.function.call.vice",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b(?=\\s*\\()"
        },
        {
          "name": "variable.parameter.named.vice",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b(?=\\s*=>)"
        }
      ]
    },
    "properties": {
      "patterns": [
        {
          "name": "variable.other.member.vice",
          "match": "(?<=\\.)[A-Za-z_][A-Za-z0-9_]*"
        },
        {
          "name": "variable.other.property-check.vice",
          "match": "(?<=:)\\s*[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.vice",
          "match": "=>|<-|->"
        },
        {
          "name": "keyword.operator.assignment.vice",
          "match": "\\+=|-=|="
        },
        {
          "name": "keyword.operator.logical.vice",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.comparison.vice",
          "match": "==|!=|>=|<=|>|<"
        },
        {
          "name": "keyword.operator.arithmetic.vice",
          "match": "\\+|-|\\*|/|%"
        },
        {
          "name": "keyword.operator.range.vice",
          "match": "\\.\\."
        }
      ]
    }
  }
}
