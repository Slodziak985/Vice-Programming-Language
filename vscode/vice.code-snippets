{
	"If Statement": {
		"prefix": "if",
		"body": [
			"if (${1:condition}) {",
			"    $0",
			"}"
		],
		"description": "If statement"
	},
	"If-Else Statement": {
		"prefix": "ifelse",
		"body": [
			"if (${1:condition}) {",
			"    $2",
			"} else {",
			"    $0",
			"}"
		],
		"description": "If-else statement"
	},
	"While Loop": {
		"prefix": "while",
		"body": [
			"while (${1:condition}) {",
			"    $0",
			"}"
		],
		"description": "While loop"
	},
	"For Range Loop": {
		"prefix": "for",
		"body": [
			"for ${1:i} in ${2:1}..${3:10} {",
			"    $0",
			"}"
		],
		"description": "Numeric range loop"
	},
	"For In Loop": {
		"prefix": "forin",
		"body": [
			"for ${1:item} in ${2:array} {",
			"    $0",
			"}"
		],
		"description": "Array iteration loop"
	},
	"Function Declaration": {
		"prefix": "fn",
		"body": [
			"fn ${1:name}(${2:params}) {",
			"    $0",
			"}"
		],
		"description": "Basic function"
	},
	"Typed Function": {
		"prefix": "fnt",
		"body": [
			"fn ${1:name}(${2:params}) -> ${3:int} {",
			"    return $0;",
			"}"
		],
		"description": "Function with return type"
	},
	"Main Entry Point": {
		"prefix": "main",
		"body": [
			"@entry",
			"fn main() {",
			"    $0",
			"}"
		],
		"description": "Main function entry point"
	},
	"Data Structure": {
		"prefix": "data",
		"body": [
			"data ${1:Name} {",
			"    ${2:field}: ${3:string} => ${4:default};",
			"}"
		],
		"description": "Data declaration"
	},
	"Int Type": {
		"prefix": "int",
		"body": "int",
		"description": "Integer type"
	},
	"Float Type": {
		"prefix": "float",
		"body": "float",
		"description": "Float type"
	},
	"String Type": {
		"prefix": "string",
		"body": "string",
		"description": "String type"
	},
	"Bool Type": {
		"prefix": "bool",
		"body": "bool",
		"description": "Boolean type"
	},
	"Input Arrow": {
		"prefix": "input",
		"body": "input -> ${1:variable};",
		"description": "Read input into variable"
	},
	"Output Arrow": {
		"prefix": "output",
		"body": "emit <- $0;",
		"description": "Send value to output"
	}
}
